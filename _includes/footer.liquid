{% comment %} AGX Lab local override of al_folio_core/_includes/footer.liquid: single-line lab copyright. {% endcomment %}
{% capture footer_contents %}
  &copy; {{ site.time | date: '%Y' }} AGX Lab. {{ site.footer_text }}
  <a href="{{ '/privacy/' | relative_url }}" class="footer-link">개인정보처리방침 · Privacy</a>
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
